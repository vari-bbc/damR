Package: damR
Title: Differential abundance of metabolomics analysis workflow
Version: 0.0.0.9000
Authors@R: 
    c(
      person("James", "Eapen", , "james.eapen@vai.org", role = c("aut", "cre")),
      person("Daniela", "DeWeerd", , "daniella.deweerd@vai.org", role = c("aut")),
